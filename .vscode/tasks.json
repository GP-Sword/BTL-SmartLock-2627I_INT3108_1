{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build debug",
            "type": "shell",
            "command": "cmake --preset debug && cmake --build --preset debug",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build test (test hook)",
            "type": "shell",
            "command": "cmake --preset test && cmake --build --preset test",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Host unit tests",
            "type": "shell",
            "command": "cmake -S tests/host -B build/host -G Ninja && cmake --build build/host && ctest --test-dir build/host --output-on-failure",
            "group": "test",
            "problemMatcher": ["$gcc"]
        }
    ]
}
